# Weather Station Bridge — configuración de instalación.
#
# Copiá este archivo como `.env`, al lado del docker-compose.yml, y cambiá lo que necesites.
# Todo tiene un valor por defecto razonable: se puede levantar sin tocar nada.
#
#     cp .env.ejemplo .env
#     docker compose up -d
#
# NO SE VERSIONA. Acá adentro va la contraseña del administrador y la del broker MQTT.
#
# ─────────────────────────────────────────────────────────────────────────────
# LA REGLA, y conviene tenerla clara antes de empezar:
#
#     el .env decide cómo NACE la instalación; el panel decide cómo sigue.
#
# Estas variables se aplican **la primera vez**, cuando todavía no existe el config.json. De
# ahí en más lo que valga es lo que esté cargado en el panel: si cambiás algo ahí y reiniciás
# el contenedor, tu cambio NO se revierte.
#
# Dos excepciones, a propósito:
#
#   MQTT_HOST / MQTT_USUARIO / MQTT_CLAVE  se leen en vivo cuando los campos del panel están
#       vacíos. Así se puede rotar la clave del broker cambiando este archivo y reiniciando,
#       sin tener que entrar al panel.
#
#   ADMIN_RESET=1  vuelve a aplicar el usuario y la contraseña de abajo, aunque ya existan.
#       Es la salida de emergencia si perdiste la clave.
#
# Para volver a empezar de cero: parar el contenedor, borrar el config.json de la carpeta de
# datos, y levantarlo de nuevo. El archivo crudo de las estaciones no se toca.


# ─────────────────────────────────────────────────────────────────────────────
# EL ADMINISTRADOR
#
# Si ponés estas dos, el puente arranca con el usuario ya creado y entrás directo.
# Si las dejás vacías, la primera vez que abras el panel te pide crearlo ahí.
#
# SOLO SE APLICAN SI NO HAY NINGUN USUARIO TODAVIA. Si después cambiás la contraseña desde el
# panel, un reinicio del contenedor NO te la revierte: eso sería una puerta trasera permanente
# escrita en un archivo de texto.
#
# La contraseña necesita al menos 8 caracteres. Una vez que entraste, podés cambiarla desde el
# panel y borrar estas dos líneas.
ADMIN_USUARIO=
ADMIN_CLAVE=

# Salida de emergencia: si perdiste la contraseña, poné esto en 1, reiniciá el contenedor, y
# las dos variables de arriba se vuelven a aplicar. Sacalo después.
# ADMIN_RESET=1

# Dejar el panel SIN ninguna contraseña. Sólo tiene sentido en una red de confianza y en la que
# nadie más entre. Apagado a propósito: un panel abierto tiene que ser una decisión.
# PANEL_ABIERTO=1


# ─────────────────────────────────────────────────────────────────────────────
# RED
#
# POR DONDE SE ABRE EL PANEL Y A DONDE APUNTAN LOS GATEWAYS.
#
# Es lo primero que hay que cambiar si el 8088 ya lo usa otra cosa en tu servidor. Adentro del
# contenedor siempre es 8088, y no hace falta que coincidan.
PUERTO=8088

# La hora del registro. Sin esto sale en UTC y hay que restar mentalmente cada vez que uno
# busca a qué hora pasó algo.
TZ=America/Argentina/Buenos_Aires


# ─────────────────────────────────────────────────────────────────────────────
# DONDE SE GUARDAN LOS DATOS
#
# Adentro va lo único que no se puede perder:
#   <estación>/AAAAMMDD.txt   el archivo crudo, una carpeta por estación y un archivo por día
#   config.json               estaciones, destinos, credenciales y usuarios
#   clave_sesion              con qué se firman las sesiones
#   respaldos/                las 30 versiones anteriores de config.json
#
# Puede ser una ruta relativa (./datos) o absoluta (/volume1/docker/ws-bridge/datos).
RUTA_DATOS=./datos

# QUIEN CORRE EL PROCESO. Por defecto arranca como root y baja solo a un usuario sin
# privilegios, después de acomodar el dueño del volumen. Eso funciona en cualquier instalación.
#
# Si tu sistema no deja hacer ese chown —algunos NAS, algunos montajes de red— poné acá el uid y
# el gid que son dueños de RUTA_DATOS y el contenedor corre directo con ellos.
#
#   Linux/macOS:  id -u   y   id -g
#   Synology:     se ve en la pestaña Usuarios del DSM
UID_DATOS=0
GID_DATOS=0


# ─────────────────────────────────────────────────────────────────────────────
# HOME ASSISTANT (opcional)
#
# El puente publica los sensores por MQTT con auto-descubrimiento: aparecen solos, un aparato
# por estación. Si no usás Home Assistant, dejá esto vacío y el puente funciona igual —
# recibe, archiva y reparte a los demás servicios.
#
# También se puede cargar desde el panel (Ajustes → MQTT), y lo del panel tiene prioridad.
MQTT_HOST=
MQTT_PUERTO=1883
MQTT_USUARIO=
MQTT_CLAVE=

# La raíz de los temas. Cada estación cuelga de acá con su propio identificador:
#   estacion/patio/datos
# Sólo hace falta cambiarla si corrés DOS puentes contra el mismo Home Assistant.
RAIZ_MQTT=estacion

# El prefijo de auto-descubrimiento de Home Assistant. Casi nadie lo cambia.
PREFIJO_HA=homeassistant

# Cómo se va a llamar el puente en Home Assistant.
NOMBRE_NODO=Weather Station Bridge


# ─────────────────────────────────────────────────────────────────────────────
# MODOS DE PRUEBA
#
# SECO=1      recibe y archiva, pero no manda a ningún destino.
# SIN_MQTT=1  reparte, pero no publica nada a Home Assistant.
#
# Sirven para levantarlo la primera vez y ver que los datos entran, antes de conectarlo a nada.
# SECO=1
# SIN_MQTT=1
